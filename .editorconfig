# Editor settings for the workable game/ tree (scooby-engine style; the full
# C layout is game/.clang-format). src/ is the byte-exact reference and keeps
# its original layout, so no rules apply to it.
root = true

[game/**.{c,h}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 80

[game/**.json]
indent_style = space
indent_size = 1

# The C++ modules under sources/ (scooby-engine style; the full layout is
# sources/.clang-format) and the buildutil/CMake files around them.
[sources/**.{hpp,cpp}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 80

[{CMakeLists.txt,sources/**/CMakeLists.txt,cmake/*.cmake,buildutil.toml}]
indent_style = space
indent_size = 2
