# Local dependencies and reproducible build products
.venv/
/build/
/reference/
__pycache__/
*.py[cod]
.DS_Store

# Generated binary views, emulator states and transient diagnostics
/analysis/images/
/analysis/native-ghidra/*.bin
/analysis/native-ghidra/*.stderr.txt
/analysis/scenarios/*.state.bin
/analysis/fmdrv/*.COM
/analysis/*.log
/analysis/*.lst

# Per-suite validator reports are regenerated by every gate run (only their runtime changes)
/analysis/*-validation.json
!/analysis/linked-fragments-validation.json
