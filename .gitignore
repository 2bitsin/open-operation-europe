# Local dependencies and reproducible build products. Rules without a trailing
# slash also cover the .venv and reference symlinks used by worktrees.
.venv
/build/
/reference
__pycache__/
*.py[cod]
.DS_Store

# Every transient output (per-suite validator reports, DOSBox logs, binary
# views, emulator states, decompiler scratch) is written under
# /build/reports/ by the tools; analysis/, docs/ and verification/ hold only
# tracked files.
/port/build/

# buildutil (buildutil.toml): everything underscore-prefixed at the root is
# derived, local working state -- _build/, _install/, _conanhome/, _pyvenv/,
# _bdudata/, _profiles/ (`buildutil clean --nuke` wipes exactly this set).
/_*
# conan writes it on every install; buildutil drives cmake directly
CMakeUserPresets.json
# local secrets (CONAN_REMOTE_* etc.), read by buildutil's dotenv
.env
# regenerated by buildutil from the live build state on every configure
/.vscode/c_cpp_properties.json
/.vscode/tasks.json
/.vscode/launch.json
/.clangd
.pytest_cache
