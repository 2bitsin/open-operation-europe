# clang-tidy for the finished modules (docs/building.md "clang-tidy"). The three groups the roadmap names, with the
# owning-memory, bounds, loop-convert and C-array checks among them; they are noisy on legacy code and apply to
# finished modules. A legacy directory relaxes checks in its own .clang-tidy (InheritParentConfig), each with a reason.
# House exceptions:
#   readability-identifier-length          x, y, i, n are the game's coordinates and counters
#   readability-magic-numbers,
#   cppcoreguidelines-avoid-magic-numbers  the game's numbers are its data (screen positions, table sizes, codes)
#   readability-braces-around-statements   .clang-format keeps short ifs and loops on one line without braces
#   readability-uppercase-literal-suffix   the house writes literal suffixes in lower case (`uz`, `u`)
#   readability-trailing-comma             .clang-format lays out braced lists; a forced comma breaks table rows
#   modernize-use-designated-initializers  data tables are positional rows, one record per line
#   cppcoreguidelines-pro-type-union-access unions stay where the data overlaps (docs/roadmap.md M4)
#   cppcoreguidelines-avoid-do-while       a loop that runs once before its test reads best as do-while
# readability-identifier-naming carries the house naming convention, docs/naming.md (authoritative; the rename tool
# reads the same rules from its convention.json). Ignored names are the protocols C++, the standard library, oxbox and
# SDL fix (begin/end, value_type, await_*, reflect_scheme, SDL_App*) and `_Detail` helpers left out of a re-export.
Checks: >
  -*,
  modernize-*,
  cppcoreguidelines-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-braces-around-statements,
  -readability-uppercase-literal-suffix,
  -readability-trailing-comma,
  -modernize-use-designated-initializers,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-avoid-do-while
WarningsAsErrors: ''
HeaderFilterRegex: 'sources/opeu/'
FormatStyle: file
CheckOptions:
  readability-identifier-naming.NamespaceCase:                   lower_case
  readability-identifier-naming.InlineNamespaceCase:             lower_case
  readability-identifier-naming.ClassCase:                       CamelCase
  readability-identifier-naming.StructCase:                      CamelCase
  readability-identifier-naming.UnionCase:                       CamelCase
  readability-identifier-naming.ClassIgnoredRegexp:              '^(promise_type|tuple_size|tuple_element|hash|formatter)$'
  readability-identifier-naming.StructIgnoredRegexp:             '^(promise_type|tuple_size|tuple_element|hash|formatter)$'
  readability-identifier-naming.EnumCase:                        CamelCase
  readability-identifier-naming.EnumConstantCase:                UPPER_CASE
  readability-identifier-naming.ScopedEnumConstantCase:          UPPER_CASE
  readability-identifier-naming.TypeAliasCase:                   CamelCase
  readability-identifier-naming.TypedefCase:                     CamelCase
  readability-identifier-naming.TypeAliasIgnoredRegexp:          '^(value_type|element_type|size_type|difference_type|reference|const_reference|pointer|const_pointer|iterator|const_iterator|iterator_category|iterator_concept|type|is_transparent|promise_type)$'
  readability-identifier-naming.ConceptCase:                     CamelCase
  readability-identifier-naming.FunctionCase:                    CamelCase
  readability-identifier-naming.FunctionIgnoredRegexp:           '^(main|reflect_scheme|reflect_call_scheme|reflect_interface_scheme|SDL_App[A-Z][A-Za-z]*|_[A-Z][A-Za-z0-9]*)$'
  readability-identifier-naming.MethodCase:                      CamelCase
  readability-identifier-naming.MethodIgnoredRegexp:             '^(begin|end|cbegin|cend|rbegin|rend|size|empty|data|get|swap|what|await_ready|await_suspend|await_resume|get_return_object|initial_suspend|final_suspend|return_void|return_value|yield_value|unhandled_exception|overflow|underflow|xsputn|sync|_[A-Z][A-Za-z0-9]*)$'
  readability-identifier-naming.PublicMemberCase:                lower_case
  readability-identifier-naming.ProtectedMemberCase:             lower_case
  readability-identifier-naming.ProtectedMemberPrefix:           _
  readability-identifier-naming.PrivateMemberCase:               lower_case
  readability-identifier-naming.PrivateMemberPrefix:             _
  readability-identifier-naming.ClassMemberCase:                 lower_case
  readability-identifier-naming.ClassMemberPrefix:               _
  readability-identifier-naming.ClassConstantCase:               UPPER_CASE
  readability-identifier-naming.ConstexprVariableCase:           UPPER_CASE
  readability-identifier-naming.ConstexprVariableIgnoredRegexp:  '^value$'
  readability-identifier-naming.GlobalConstantCase:              UPPER_CASE
  readability-identifier-naming.StaticConstantCase:              UPPER_CASE
  readability-identifier-naming.GlobalVariableCase:              lower_case
  readability-identifier-naming.StaticVariableCase:              lower_case
  readability-identifier-naming.LocalConstantCase:               lower_case
  readability-identifier-naming.LocalVariableCase:               lower_case
  readability-identifier-naming.ParameterCase:                   lower_case
  readability-identifier-naming.ConstantParameterCase:           lower_case
  readability-identifier-naming.TypeTemplateParameterCase:       CamelCase
  readability-identifier-naming.TypeTemplateParameterPrefix:     _
  readability-identifier-naming.ValueTemplateParameterCase:      UPPER_CASE
  readability-identifier-naming.TemplateTemplateParameterCase:   CamelCase
  readability-identifier-naming.TemplateTemplateParameterPrefix: _
  readability-identifier-naming.MacroDefinitionCase:             UPPER_CASE
