# Preserve the supplied DOS fixtures byte for byte.
/binaries/** binary
# Generated evidence may retain spacing from the original data or tools.
/analysis/** -whitespace
/verification/** -whitespace
/docs/** -whitespace
# Asset packs: the checked-in packs (and the tests' remaster sample) are compared byte for byte with what the tools
# write, so no checkout (Windows autocrlf included) may change their bytes.
*.opeupack binary
/sources/opeu/assets/**/*.png binary
/sources/opeu/assets/**/pack.json -text eol=lf
